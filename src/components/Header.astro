---
import { business, routes, type RouteKey } from '../data/site';
import { pathFor, switchLocalePath, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  route?: RouteKey;
}

const { lang, route } = Astro.props;
const d = t(lang);

// The toggle points at the *same page* in the other language, not at its home
// page — switching language should never lose your place.
const thHref = switchLocalePath(Astro.url.pathname, 'th');
const enHref = switchLocalePath(Astro.url.pathname, 'en');
---

<header class="topbar">
  <div class="topbar__inner">
    <a class="brand" href={pathFor('home', lang)}>
      <span class="brand__en">{business.nameEn}</span>
      <span class="brand__th">{business.nameTh}</span>
    </a>

    <nav class="mainnav" aria-label={d.navLabel}>
      {
        routes.map((key) => (
          <a href={pathFor(key, lang)} aria-current={key === route ? 'page' : undefined}>
            {d.nav[key]}
          </a>
        ))
      }
    </nav>

    <div class="topbar__right">
      <div class="lang" role="group" aria-label={d.langLabel}>
        <a
          href={thHref}
          hreflang="th"
          lang="th"
          class:list={['lang__opt', lang === 'th' && 'is-active']}
          aria-current={lang === 'th' ? 'true' : undefined}>TH</a
        >
        <span class="lang__sep" aria-hidden="true">|</span>
        <a
          href={enHref}
          hreflang="en"
          lang="en"
          class:list={['lang__opt', lang === 'en' && 'is-active']}
          aria-current={lang === 'en' ? 'true' : undefined}>EN</a
        >
      </div>
      <a class="callbtn" href={business.phoneHref}>{business.phone}</a>
    </div>
  </div>
</header>
