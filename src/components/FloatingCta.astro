---
/**
 * The two actions that actually convert — add LINE, or call — pinned so they
 * are reachable from any scroll position on any page.
 *
 * Plain anchors, no JS: on a phone this is a two-up bar across the bottom;
 * from 761px up it becomes a labelled pill stack in the bottom-right corner.
 * `site.css` pads the shell so the mobile bar never covers the footer's last
 * line.
 */
import { business } from '../data/site';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<nav class="floatcta" aria-label={d.floatingCta.groupLabel}>
  <a
    class="floatcta__btn floatcta__btn--line"
    href={business.lineUrl}
    target="_blank"
    rel="noopener"
    aria-label={`${d.floatingCta.line} ${business.lineId}`}
  >
    <svg class="floatcta__icon" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2C6.48 2 2 5.69 2 10.23c0 4.07 3.55 7.48 8.35 8.13.32.07.77.22.88.5.1.25.07.65.03.9l-.14.85c-.04.25-.2.99.87.54s5.75-3.39 7.85-5.8C21.28 13.72 22 12.06 22 10.23 22 5.69 17.52 2 12 2ZM8.16 12.9H6.17a.53.53 0 0 1-.53-.53V8.4a.53.53 0 0 1 1.05 0v3.45h1.47a.53.53 0 0 1 0 1.05Zm2.06-.53a.53.53 0 0 1-1.05 0V8.4a.53.53 0 0 1 1.05 0v3.97Zm4.78 0a.53.53 0 0 1-.95.32l-2.04-2.78v2.46a.53.53 0 0 1-1.05 0V8.4a.53.53 0 0 1 .95-.32l2.04 2.78V8.4a.53.53 0 0 1 1.05 0v3.97Zm3.2-2.51a.53.53 0 0 1 0 1.05h-1.47v.94h1.47a.53.53 0 0 1 0 1.05h-2a.53.53 0 0 1-.52-.53V8.4a.53.53 0 0 1 .53-.53h1.99a.53.53 0 0 1 0 1.06h-1.47v.93h1.47Z"
      />
    </svg>
    <span class="floatcta__label">{d.floatingCta.line}</span>
  </a>

  <a
    class="floatcta__btn floatcta__btn--call"
    href={business.phoneHref}
    aria-label={`${d.floatingCta.call} ${business.phone}`}
  >
    <svg class="floatcta__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
    </svg>
    <span class="floatcta__label">{d.floatingCta.call}</span>
  </a>
</nav>
