---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Media from "../components/Media.astro";
import Slideshow from "../components/Slideshow.astro";
import { cars, featuredCarIds } from "../data/site";
import { customerPhotos } from "../data/customerPhotos";
import { pathFor, t, type Locale } from "../i18n";
import bannerFull from "../assets/img/banner-full.webp";
import bannerFullEng from "../assets/img/banner-full-eng.webp";
import bannerSquare from "../assets/img/banner-square.webp";
import bannerSquareEng from "../assets/img/banner-square-eng.webp";
import tabian from "../assets/img/tabian.jpg";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);

const priceOf = (id: string) => cars.find((c) => c.id === id)!.price;
const photoOf = (id: string) => cars.find((c) => c.id === id)!.photo;
const heroCustomerPhotos = customerPhotos.slice(0, 5);
// Resolved through `getImage()` rather than <Image>: the desktop banner is a
// CSS background (no element to hang a srcset on) and the mobile one is
// preloaded, which needs one URL the markup is guaranteed to request. Both
// come back as hashed, resized webp all the same.
const banner = await getImage({
  src: lang === "en" ? bannerFullEng : bannerFull,
  width: 1800,
  format: "webp",
  // One file, not a srcset: nothing here can consume extra candidates — the
  // desktop banner is a CSS background and the mobile one is preloaded by
  // exact URL — and the global `constrained` layout would emit six unused
  // derivatives per banner.
  layout: "none",
  // The source is already webp; re-encoding at the default quality of 80 came
  // out *larger* than the original. 70 halves it with no visible difference at
  // banner size, and this is the LCP image on every home page view.
  quality: 70,
});
const bannerMobile = await getImage({
  src: lang === "en" ? bannerSquareEng : bannerSquare,
  width: 800,
  format: "webp",
  layout: "none",
  quality: 70,
});

// The banner is the LCP element in both layouts, so both sources are
// preloaded behind the same 700px query the CSS switches on — see
// `.hero__banner-mobile` in site.css. Keep the two in step.
const heroPreload = [
  { href: banner.src, media: "(min-width: 701px)" },
  { href: bannerMobile.src, media: "(max-width: 700px)" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: d.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Base
  lang={lang}
  route="home"
  title={d.meta.home.title}
  description={d.meta.home.description}
  preloadImage={heroPreload}
>
  <section
    class="hero hero--home"
    style={`--hero-bg: url(${banner.src}); --hero-bg-mobile: url(${bannerMobile.src});`}
  >
    <div class="kicker">{d.home.kicker}</div>
    <h1 class="display-xl">
      {d.home.headingLines[0]}<br />{d.home.headingLines[1]}
    </h1>
    <p class="hero__lede">{d.home.lede}</p>
    <div class="btnrow">
      <a class="cta cta--line" href={pathFor("contact", lang)}
        >{d.home.ctaLine}</a
      >
      <a class="cta cta--ghost" href={pathFor("cars", lang)}>{d.home.ctaCars}</a
      >
    </div>
    <img
      class="hero__banner-mobile"
      src={bannerMobile.src}
      width={bannerMobile.attributes.width ?? 800}
      height={bannerMobile.attributes.height ?? 800}
      alt={d.alt.heroBanner}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </section>

  <div class="stats">
    {
      d.home.stats.map((s) => (
        <div>
          <div class="stat__n">{s.n}</div>
          <div class="stat__l">{s.label}</div>
        </div>
      ))
    }
  </div>

  <section class="section">
    <div class="sectionhead">
      <h2>{d.home.carsHeading}</h2>
      <a class="arrowlink" href={pathFor("cars", lang)}>{d.common.seeAll}</a>
    </div>

    <div class="inkgrid inkgrid--2">
      {
        featuredCarIds.map((id) => (
          <article class="carrow">
            <Media
              src={photoOf(id)}
              alt={d.cars.names[id]}
              width={420}
              sizes="(max-width: 520px) 100vw, 210px"
            />
            <div>
              <div class="price-xl">{priceOf(id).toLocaleString("en-US")}</div>
              <div class="price-unit">{d.common.perDay}</div>
              <h3 class="car-name">{d.cars.names[id]}</h3>
              <div class="car-spec">{d.cars.featuredSpecs[id]}</div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--tight section--ruled">
    <div class="split split--40 split--3">
      <div>
        <h2 class="h4-like">{d.home.areasHeading}</h2>
        <div class="bigareas">
          {d.home.areasLines[0]}<br />{d.home.areasLines[1]}
        </div>
      </div>
      <div>
        <h2 class="h4-like">{d.home.reviewHeading}</h2>
        <Slideshow
          photos={heroCustomerPhotos}
          allPhotos={customerPhotos}
          alt={d.alt.customerPhoto.replace("{n}", "").trim()}
        />
        <div class="mt-14">
          <a class="arrowlink" href={pathFor("reviews", lang)}
            >{d.home.readAllReviews}</a
          >
        </div>
      </div>
      <div>
        <h2 class="h4-like">{d.about.registrationHeading}</h2>
        <div class="docphoto">
          <Image
            src={tabian}
            alt={d.alt.registration}
            width={420}
            sizes="(max-width: 860px) 100vw, 420px"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={72}
          />
          <p class="notecaption">{d.about.registrationNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight section--ruled">
    <h2 class="section-title">{d.faq.heading}</h2>
    <p class="gallerylede">{d.faq.lede}</p>

    <div class="faq">
      {
        d.faq.items.map((item, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__q">{item.q}</summary>
            <div class="faq__a">{item.a}</div>
          </details>
        ))
      }
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
