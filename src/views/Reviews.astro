---
import Base from '../layouts/Base.astro';
import { customerPhotos } from '../data/customerPhotos';
import { pathFor, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);

// How many photos render up front; the rest reveal via the "load more" button.
const PAGE_SIZE = 15;
---

<Base
  lang={lang}
  route="reviews"
  title={d.meta.reviews.title}
  description={d.meta.reviews.description}
  breadcrumbs={[{ label: d.nav.reviews, href: pathFor('reviews', lang) }]}
>
  <section class="hero">
    <div class="kicker">{d.reviews.kicker}</div>
    <h1 class="display-m">{d.reviews.headingLines[0]}<br />{d.reviews.headingLines[1]}</h1>
    <div class="scorerow">
      {
        d.reviews.scores.map((s) => (
          <div>
            <div class="score__n">{s.n}</div>
            <div class="score__l">{s.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--tight">
    <p class="gallerylede">{d.reviews.galleryNote}</p>

    <div class="inkgrid inkgrid--5 gallery" data-gallery data-page-size={PAGE_SIZE}>
      {
        customerPhotos.map((src, i) => (
          <div class="media" data-gallery-item hidden={i >= PAGE_SIZE ? true : undefined}>
            <img
              src={src}
              alt={d.alt.customerPhoto.replace('{n}', String(i + 1))}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>

    {
      customerPhotos.length > PAGE_SIZE && (
        <div class="loadmore">
          <button type="button" class="cta cta--ghost" data-gallery-more>
            {d.reviews.loadMore}
          </button>
        </div>
      )
    }
  </section>
</Base>

<script>
  // Progressive enhancement: without JS every photo is already in the markup and visible.
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const more = document.querySelector<HTMLButtonElement>('[data-gallery-more]');

  if (grid && more) {
    const pageSize = Number(grid.dataset.pageSize ?? '15');
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-gallery-item]'));

    for (const el of items.slice(pageSize)) el.hidden = true;

    more.addEventListener('click', () => {
      const hidden = items.filter((el) => el.hidden);
      for (const el of hidden.slice(0, pageSize)) el.hidden = false;
      if (hidden.length <= pageSize) more.hidden = true;
    });
  }
</script>
